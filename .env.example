# WalkSense search with Gemini. Copy this file to .env in the same folder (the repo root) and paste your key.
# .env is ignored by git: the key never gets committed. Get a key at https://aistudio.google.com/apikey
# Real environment variables override these lines.
GEMINI_API_KEY=
# Model checked on 26 Nov 2026: gemini-3.5-flash-lite (stable, fast, cheap, has a free tier).
# Cheaper stable alternative: gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for Gemini before the app answers offline (keyword, then fuzzy). Default 8.
GEMINI_TIMEOUT_S=8
