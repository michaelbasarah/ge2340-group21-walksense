# Expanded current deliverables are versioned; avoid generated duplicate archives.
phase2/*.zip
phase2/clean-data/*.zip

# 23-Nov big regenerable CSVs (rebuild: python clean.py). sensor_samples is >100MB.
phase2/clean-data/2026-11-23/sensor_samples.csv
phase2/clean-data/2026-11-23/sensors/
phase2/clean-data/2026-11-23/excluded_sensor_rows.csv
phase2/clean-data/2026-11-23/wifi/observations.csv

# Upload pipeline: phone uploads and test uploads stay local.
phase2/new/upload/uploads/
phase2/new/upload/out/test_uploads/
phase2/new/upload/recordings/

# Local virtual environment.
.venv/

# 25-Nov regenerable sensor CSVs (rebuild: python -I phase2/clean-data/2026-11-25-spots/scripts/build_clean.py, a few seconds;
# run_all.sh does it). Raw ZIPs in raw/attachments/ are committed byte-identical.
phase2/clean-data/2026-11-25-spots/clean/floor4/
phase2/clean-data/2026-11-25-spots/clean/floor5/
phase2/clean-data/2026-11-25-spots/clean/wifi/observations.csv

# 25-Nov night run regenerable sensor CSVs (rebuild: python -I phase2/clean-data/2026-11-25-night/scripts/build_night.py,
# a few seconds; run_all.sh does it). Raw ZIPs in raw/ are committed byte-identical.
phase2/clean-data/2026-11-25-night/*/clean/floor4/
phase2/clean-data/2026-11-25-night/*/clean/floor5/
phase2/clean-data/2026-11-25-night/*/clean/wifi/observations.csv
# 26-Nov morning (Tian) regenerable sensor CSVs (rebuild: python -I phase2/clean-data/2026-11-26-tian/scripts/build_tian26.py)
phase2/clean-data/2026-11-26-tian/clean/floor4/
phase2/clean-data/2026-11-26-tian/clean/floor5/
